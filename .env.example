NODE_ENV=production
JWT_SECRET=coloque-aqui-uma-string-secreta-longa-e-aleatoria
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/sassonomad
PORT=3000

# E-mail transacional (Resend: https://resend.com). Sem RESEND_API_KEY em
# desenvolvimento, os e-mails aparecem no terminal em vez de serem enviados.
RESEND_API_KEY=
EMAIL_FROM=Sasso Nomad <nomad@sassonomad.com>
EMAIL_REPLY_TO=nomad@sassonomad.com

# Endereços públicos usados nos links dos e-mails
FRONTEND_URL=https://sassonomad.com
API_URL=https://api.sassonomad.com

# Chave da rota GET /admin/stats (mínimo 24 caracteres, aleatória)
ADMIN_KEY=
